 "functions": [
  {
   "proname": "artists_guard",
   "def": "CREATE OR REPLACE FUNCTION public.artists_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if not public.is_admin() then\n    if tg_op = 'INSERT' then new.status := 'draft'; new.note := null; new.sent_at := null;\n    else\n      new.note := old.note;\n      if (old.status in ('draft', 'changes') and new.status = 'pending') then new.sent_at := now();\n      elsif (old.status = 'pending' and new.status = 'draft') then new.sent_at := old.sent_at;\n      else new.status := old.status; new.sent_at := old.sent_at; end if;\n    end if;\n  end if;\n  new.updated_at := now();\n  return new;\nend $function$\n"
  },
  {
   "proname": "handle_new_user",
   "def": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  meta jsonb := coalesce(new.raw_user_meta_data, '{}'::jsonb);\n  full_name text := coalesce(meta->>'full_name', meta->>'name', '');\nbegin\n  insert into public.profiles (id, first_name, last_name, provider)\n  values (\n    new.id,\n    nullif(coalesce(meta->>'given_name', meta->>'first_name', split_part(full_name, ' ', 1)), ''),\n    nullif(coalesce(meta->>'family_name', meta->>'last_name', regexp_replace(full_name, '^\\S+\\s*', '')), ''),\n    coalesce(new.raw_app_meta_data->>'provider', 'email'))\n  on conflict (id) do nothing;\n  if lower(new.email) in ('eladamsalem1@gmail.com', 'ooopenstudio@gmail.com') then\n    insert into public.admins (user_id) values (new.id) on conflict do nothing;\n  end if;\n  return new;\nend $function$\n"
  },
  {
   "proname": "is_admin",
   "def": "CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$ select exists (select 1 from public.admins where user_id = (select auth.uid())) $function$\n"
  },
  {
   "proname": "log_phone_vitals",
   "def": "CREATE OR REPLACE FUNCTION public.log_phone_vitals(text)\n RETURNS void\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\ndeclare j jsonb;\nbegin\n  if length($1) > 1024 then return; end if;\n  j := $1::jsonb;\n  insert into public.phone_vitals (visit, space, device, model, browser, screen_w, screen_h, dpr, first_frame_ms, frame_med_ms,\n    frame_p95_ms, frame_worst_ms, frames, heap_mb, tex_mb, context_lost, crashed, errors, seconds, owner, test)\n  values (j->>'id', j->>'space', coalesce(j->>'dev', 'other'), left(j->>'model', 60), left(j->>'br', 20),\n    (j->>'sw')::smallint, (j->>'sh')::smallint, (j->>'dpr')::real, (j->>'ff')::integer, (j->>'med')::real,\n    (j->>'p95')::real, (j->>'worst')::real, (j->>'n')::integer, (j->>'heap')::integer, (j->>'tex')::integer,\n    coalesce((j->>'lost')::boolean, false), coalesce((j->>'crash')::boolean, false), coalesce((j->>'err')::smallint, 0),\n    (j->>'s')::integer, coalesce((j->>'own')::boolean, false), coalesce((j->>'test')::boolean, false));\nend $function$\n"
  },
  {
   "proname": "phone_vitals_summary",
   "def": "CREATE OR REPLACE FUNCTION public.phone_vitals_summary(hours integer DEFAULT 24, include_tests boolean DEFAULT false)\n RETURNS TABLE(space text, device text, visits integer, tests integer, load_med_ms integer, load_worst_ms integer, frame_med_ms real, frame_worst_ms real, tex_med_mb integer, tex_worst_mb integer, heap_med_mb integer, crashes integer, context_lost integer, flags text[])\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'public'\nAS $function$\nbegin\n  if current_user in ('anon', 'authenticated') and not public.is_admin() then raise exception 'admins only'; end if;\n  return query\n  with r as (\n    select * from public.phone_vitals v\n    where v.created_at > now() - make_interval(hours => greatest(1, least(hours, 24 * 60))) and (include_tests or not v.test)\n  ), g as (\n    select r.space, r.device, count(*)::int n, count(*) filter (where r.test)::int t,\n      (percentile_disc(0.5) within group (order by r.first_frame_ms))::int ff, max(r.first_frame_ms)::int ffw,\n      (percentile_disc(0.5) within group (order by r.frame_med_ms))::real fm, max(r.frame_worst_ms)::real fw,\n      (percentile_disc(0.5) within group (order by r.tex_mb))::int tm, max(r.tex_mb)::int tw,\n      (percentile_disc(0.5) within group (order by r.heap_mb))::int hm,\n      count(*) filter (where r.crashed)::int c, count(*) filter (where r.context_lost)::int l\n    from r group by r.space, r.device\n  )\n  select g.space, g.device, g.n, g.t, g.ff, g.ffw, g.fm, g.fw, g.tm, g.tw, g.hm, g.c, g.l,\n    array_remove(array[\n      case when g.ff > (case when g.device in ('iphone', 'ipad') then 6000 else 10000 end) then 'load ' || round(g.ff / 1000.0, 1) || ' s' end,\n      case when g.fm > 50 then 'frame ' || round(g.fm::numeric) || ' ms' end,\n      case when g.c > 0 then g.c || ' crashed' end,\n      case when g.l > 0 then g.l || ' context lost' end], null)\n  from g order by (g.c + g.l) desc, g.n desc;\nend $function$\n"
  },
  {
   "proname": "touch_updated_at",
   "def": "CREATE OR REPLACE FUNCTION public.touch_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin new.updated_at = now(); return new; end $function$\n"
  },
  {
   "proname": "virtual_shows_guard",
   "def": "CREATE OR REPLACE FUNCTION public.virtual_shows_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if not public.is_admin() then\n    if tg_op = 'INSERT' then\n      new.note := null;\n      if new.status in ('pending', 'published') then new.status := 'pending'; new.sent_at := now();\n      else new.status := 'draft'; new.sent_at := null; end if;\n    else\n      new.note := old.note; new.sent_at := old.sent_at;\n      if old.status = 'published' then\n        if new.status <> 'published' then new.status := 'draft'; end if;          -- taken down by the artist\n      elsif new.status in ('pending', 'published') then\n        if old.status <> 'pending' then new.sent_at := now(); end if;             -- sent for a look\n        new.status := 'pending';\n      elsif new.status <> old.status then new.status := 'draft';                  -- taken back\n      end if;\n    end if;\n  end if;\n  return new;\nend $function$\n"
  },
  {
   "proname": "works_keep_review",
   "def": "CREATE OR REPLACE FUNCTION public.works_keep_review()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  if not public.is_admin() then\n    if tg_op = 'INSERT' then new.hidden := false; new.reviewed_at := null;\n    else new.hidden := old.hidden; new.reviewed_at := old.reviewed_at; end if;\n  end if;\n  return new;\nend $function$\n"
  }
