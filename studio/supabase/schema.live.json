 "checks": [
  {
   "table": "artists",
   "conname": "artists_name_check",
   "def": "CHECK (((length(name) >= 1) AND (length(name) <= 120)))"
  },
  {
   "table": "artists",
   "conname": "artists_slug_check",
   "def": "CHECK ((slug ~ '^[a-z0-9][a-z0-9-]{1,59}$'::text))"
  },
  {
   "table": "artists",
   "conname": "artists_status_check",
   "def": "CHECK ((status = ANY (ARRAY['draft'::text, 'pending'::text, 'changes'::text, 'approved'::text, 'hidden'::text])))"
  },
  {
   "table": "change_requests",
   "conname": "change_requests_body_check",
   "def": "CHECK (((length(body) >= 3) AND (length(body) <= 4000)))"
  },
  {
   "table": "change_requests",
   "conname": "change_requests_status_check",
   "def": "CHECK ((status = ANY (ARRAY['open'::text, 'filed'::text, 'done'::text])))"
  },
  {
   "table": "conversations",
   "conname": "conversations_status_check",
   "def": "CHECK ((status = ANY (ARRAY['open'::text, 'answered'::text, 'closed'::text])))"
  },
  {
   "table": "messages",
   "conname": "messages_body_check",
   "def": "CHECK (((length(body) >= 1) AND (length(body) <= 5000)))"
  },
  {
   "table": "museum_colours",
   "conname": "museum_colours_colour_check",
   "def": "CHECK ((colour ~ '^#[0-9a-fA-F]{6}$'::text))"
  },
  {
   "table": "museum_colours",
   "conname": "museum_colours_slug_check",
   "def": "CHECK (((length(slug) >= 1) AND (length(slug) <= 120)))"
  },
  {
   "table": "museum_exhibitions",
   "conname": "museum_exhibitions_title_check",
