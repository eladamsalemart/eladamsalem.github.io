 "functions": [
  {
   "proname": "artists_guard",
   "def": "CREATE OR REPLACE FUNCTION public.artists_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if not public.is_admin() then\n    if tg_op = 'INSERT' then new.status := 'draft'; new.note := null; new.sent_at := null;\n    else\n      new.note := old.note;\n      if (old.status in ('draft', 'changes') and new.status = 'pending') then new.sent_at := now();\n      elsif (old.status = 'pending' and new.status = 'draft') then new.sent_at := old.sent_at;\n      else new.status := old.status; new.sent_at := old.sent_at; end if;\n    end if;\n  end if;\n  new.updated_at := now();\n  return new;\nend $function$\n"
  },
  {
   "proname": "handle_new_user",
   "def": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  meta jsonb := coalesce(new.raw_user_meta_data, '{}'::jsonb);\n  full_name text := coalesce(meta->>'full_name', meta->>'name', '');\nbegin\n  insert into public.profiles (id, first_name, last_name, provider)\n  values (\n    new.id,\n    nullif(coalesce(meta->>'given_name', meta->>'first_name', split_part(full_name, ' ', 1)), ''),\n    nullif(coalesce(meta->>'family_name', meta->>'last_name', regexp_replace(full_name, '^\\S+\\s*', '')), ''),\n    coalesce(new.raw_app_meta_data->>'provider', 'email'))\n  on conflict (id) do nothing;\n  if lower(new.email) in ('eladamsalem1@gmail.com', 'ooopenstudio@gmail.com') then\n    insert into public.admins (user_id) values (new.id) on conflict do nothing;\n  end if;\n  return new;\nend $function$\n"
  },
  {
   "proname": "is_admin",
   "def": "CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$ select exists (select 1 from public.admins where user_id = (select auth.uid())) $function$\n"
  },
  {
   "proname": "touch_updated_at",
   "def": "CREATE OR REPLACE FUNCTION public.touch_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin new.updated_at = now(); return new; end $function$\n"
  },
  {
   "proname": "works_keep_review",
   "def": "CREATE OR REPLACE FUNCTION public.works_keep_review()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  if not public.is_admin() then\n    if tg_op = 'INSERT' then new.hidden := false; new.reviewed_at := null;\n    else new.hidden := old.hidden; new.reviewed_at := old.reviewed_at; end if;\n  end if;\n  return new;\nend $function$\n"
  }
 ]
}
