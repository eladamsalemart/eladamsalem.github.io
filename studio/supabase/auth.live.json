 "mailer_subjects_recovery": "Reset your password",
 "mailer_templates_confirmation_content": "<div style=\"background:#F6F1E7;padding:28px 0\"><div style=\"max-width:460px;margin:0 auto;padding:32px 26px;background:#FFFDF8;color:#1B1A17;border-radius:18px\"><p style=\"font:700 15px Helvetica,Arial,sans-serif;margin:0 0 30px;letter-spacing:-.01em\">Open Studio</p><h1 style=\"font:400 30px/1.1 Georgia,'Times New Roman',serif;margin:0 0 10px\">Welcome to Open Studio</h1><p style=\"font:16px/1.5 Helvetica,Arial,sans-serif;margin:0 0 22px;color:#3F3B35\">Type this code in the app to finish signing up:</p><p style=\"font:600 42px/1 Helvetica,Arial,sans-serif;letter-spacing:10px;margin:0 0 30px\">{{ .Token }}</p><p style=\"font:15px/1.5 Helvetica,Arial,sans-serif;margin:0 0 14px;color:#3F3B35\">Or open Open Studio straight from here:</p><p style=\"margin:0 0 28px\"><a href=\"{{ .SiteURL }}?token_hash={{ .TokenHash }}&amp;type=email\" style=\"display:inline-block;background:#1B1A17;color:#F6F1E7;font:600 16px Helvetica,Arial,sans-serif;padding:14px 26px;border-radius:999px;text-decoration:none\">Sign in to Open Studio</a></p><p style=\"font:13px/1.5 Helvetica,Arial,sans-serif;color:#6B655B;margin:0\">The code works once, for an hour; a new email replaces it. If you didn't ask for it, you can ignore this email.</p></div></div>",
 "mailer_templates_custom_contents": {
  "MAILER_TEMPLATES_CONFIRMATION_CONTENT": true,
  "MAILER_TEMPLATES_EMAIL_CHANGE_CONTENT": false,
  "MAILER_TEMPLATES_INVITE_CONTENT": false,
  "MAILER_TEMPLATES_MAGIC_LINK_CONTENT": true,
  "MAILER_TEMPLATES_REAUTHENTICATION_CONTENT": false,
  "MAILER_TEMPLATES_RECOVERY_CONTENT": false,
  "MAILER_TEMPLATES_PASSWORD_CHANGED_NOTIFICATION_CONTENT": false,
  "MAILER_TEMPLATES_EMAIL_CHANGED_NOTIFICATION_CONTENT": false,
  "MAILER_TEMPLATES_PHONE_CHANGED_NOTIFICATION_CONTENT": false,
  "MAILER_TEMPLATES_MFA_FACTOR_ENROLLED_NOTIFICATION_CONTENT": false,
  "MAILER_TEMPLATES_MFA_FACTOR_UNENROLLED_NOTIFICATION_CONTENT": false,
